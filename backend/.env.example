# Copiază acest fișier în .env și completează valorile locale.
# Fișierul .env nu se comite în Git.

DATABASE_URL=postgresql+psycopg://car_tracker:parola_locala@localhost:5432/car_tracker

# Secretul de semnare JWT. Generează o valoare aleatoare, diferită de
# cea din producție, de exemplu cu:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=schimba_aceasta_valoare
ACCESS_TOKEN_EXPIRE_MINUTES=60
